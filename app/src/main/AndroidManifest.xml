<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 声明为手表应用，Play / 侧载时按 Wear 形态处理 -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <!-- 游戏过程中保持屏幕常亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 打击感的触觉反馈：出牌 / 倍率 / 乘算 / 结算分四档 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WristJoker">

        <!-- Wear OS 上可选依赖，缺失也不影响运行 -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- 独立运行，不要求配对手机 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WristJoker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            手表卡片（三星叫「卡片」，Wear OS 叫 Tile）。

            exported 必须为 true：卡片由系统表盘进程跨应用绑定。
            permission 不是自选的，是 TileService 的绑定契约 ——
            少了它，系统会拒绝连接，卡片列表里能看到但点开是空白。
        -->
        <service
            android:name=".tile.JokerTileService"
            android:description="@string/tile_desc"
            android:exported="true"
            android:label="@string/tile_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!--
            表盘小部件（Complication）：当前底注 + 分数进度。

            和 Tile 是两条路：Tile 要右滑一次，Complication 在表盘上就有。
            权限与 action 用的是 framework 的旧命名空间（android.support.wearable），
            这是 Complication 数据源协议本身的字符串，不是我们可以改的 ——
            写成 androidx.* 系统会找不到这个源。
        -->
        <service
            android:name=".complication.JokerComplicationService"
            android:exported="true"
            android:label="@string/tile_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,RANGED_VALUE" />
            <!-- 300 秒是系统允许的最短周期。一局十几分钟，五分钟一次的
                 "还差多少"已经够用；再密会明显吃续航。 -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
    </application>

</manifest>
