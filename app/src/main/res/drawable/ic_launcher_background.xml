<?xml version="1.0" encoding="utf-8"?>
<!--
    图标背景：深咖底 + 两层同心圆做"顶灯打在纸上"的径向感。

    vector 的 <gradient> 在 adaptive icon 的裁剪下容易出硬边，所以用两个
    实心圆叠出三级亮度 —— 在 48dp 的图标尺寸上，看不出它们是同心圆。
    坐标：108 viewport，外圈 r=46 略小于画布，避免方屏裁切时露出直角。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1B1713"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#221C17"
        android:pathData="M54,54m-46,0a46,46 0 1,0 92,0a46,46 0 1,0 -92,0" />
    <path
        android:fillColor="#2A241E"
        android:pathData="M54,54m-30,0a30,30 0 1,0 60,0a30,30 0 1,0 -60,0" />
</vector>
